# ---------- Branding / contact (public, baked in at BUILD time) ----------
# Leave unset to keep the on-page [PLACEHOLDERS] visible.
NEXT_PUBLIC_AGENCY_NAME=
NEXT_PUBLIC_PHONE=                 # e.g. 1300 000 000 (digits are used for tel: links)
NEXT_PUBLIC_EMAIL=                 # public contact email shown on the page
NEXT_PUBLIC_SERVICE_AREA=          # e.g. "Australia-wide" – only if true
NEXT_PUBLIC_ABN=                   # e.g. 12 345 678 901
NEXT_PUBLIC_PRIVACY_URL=           # link to the real privacy policy
NEXT_PUBLIC_TERMS_URL=             # link to the real terms & conditions
NEXT_PUBLIC_SITE_URL=              # https://your-domain.com.au (used for canonical/OG/sitemap)
NEXT_PUBLIC_PORTAL_URL=            # optional: https://portal.your-domain.com.au – shows a "Client login" link

# ---------- SEO ----------
# robots.txt + meta robots stay NOINDEX until this is "true". Set only after review.
ALLOW_INDEXING=false

# ---------- Analytics (optional, public, build time) ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=     # G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=                # GTM-XXXXXXX

# ---------- Enquiry delivery (server-only secrets – NEVER prefix with NEXT_PUBLIC_) ----------
ENQUIRY_TO_EMAIL=                  # where enquiry notifications go
ENQUIRY_FROM_EMAIL=                # verified sender, e.g. "Enquiries <enquiries@your-domain.com.au>"
RESEND_API_KEY=                    # https://resend.com (HTTPS API – works on Railway)
ENQUIRY_WEBHOOK_URL=               # optional: also POST enquiry JSON (Zapier / Make / GHL inbound webhook)
ENQUIRY_WEBHOOK_SECRET=            # optional: sent as X-Webhook-Secret header

# Dev only: when no delivery channel is configured, NODE_ENV=development logs the
# enquiry to the console. In production the API returns 503 instead of pretending.
